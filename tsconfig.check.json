/*
 * This is only used for typechecking!
 */
{
  "extends": "@marigold/tsconfig/react",
  "compilerOptions": {
    // Here rather than on the command line, so `pnpm typecheck`, the CI job and the post-edit
    // hook cannot drift apart on the flags that decide what is checked.
    "noEmit": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "jsx": "preserve",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      ".storybook/*": ["./.storybook/*"],
      "@marigold/*": ["./packages/*/src", "./themes/*/src"],
      "@marigold/theme-rui/appearances": ["./themes/theme-rui/src/appearances"],
      "@/*": ["./docs/*"],
      "fumadocs-mdx:collections/*": ["./docs/.source/*"],
      // cva does not export the types officially
      "class-variance-authority/dist/types": [
        "./packages/system/node_modules/class-variance-authority/dist/types"
      ]
    },
    "types": ["vitest/globals"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "coverage/*",
    "vitest.config.shared.ts",
    "vite.config.ts",
    "**/dist/*",
    "**/node_modules/*",
    "docs/**/*",
    ".claude/**/*",
    "**/validate/examples/*"
  ]
}
